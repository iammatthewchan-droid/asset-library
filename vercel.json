{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/asset-library/:path*",
      "destination": "/:path*"
    }
  ],
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "destination": "/asset-library/next19.html?drawer=all",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
